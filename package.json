{
  "name": "health-engine-tz",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run sync-ocr-assets && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "build:native": "npm run build && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:add-android": "npx cap add android",
    "cap:open": "npx cap open android",
    "vercel-build": "npm run sync-ocr-assets && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "type-check": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-ocr-assets": "node scripts/sync-ocr-assets.mjs",
    "sync-hero-webp": "node scripts/sync-hero-webp.mjs",
    "verify:apk-design": "node scripts/check-apk-markers.mjs",
    "postinstall": "node scripts/sync-ocr-assets.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@napi-rs/canvas": "^1.0.7",
    "@supabase/supabase-js": "^2.106.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "chart.js": "^4.5.1",
    "fflate": "^0.8.3",
    "fit-file-parser": "^5.0.2",
    "html5-qrcode": "^2.3.8",
    "iconv-lite": "^0.7.2",
    "pdfjs-dist": "^6.0.227",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/tesseract.js": "^0.0.2",
    "@types/three": "^0.160.0",
    "@vercel/node": "^5.8.23",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^24.1.3",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "1.0",
    "vitest": "^1.6.1",
    "xlsx": "^0.18.5"
  }
}
