<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- TOP: App Shortcuts (долгое нажатие по иконке). Только APK. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Homescreen-виджеты APK (только native; Telegram Mini App их не имеет) -->
        <receiver
            android:name=".widgets.TrainingWidgetProvider"
            android:exported="false"
            android:label="@string/widget_training_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_training_info" />
        </receiver>
        <receiver
            android:name=".widgets.TimerWidgetProvider"
            android:exported="false"
            android:label="@string/widget_timer_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.healthengine.app.action.TIMER_CMD" />
                <action android:name="com.healthengine.app.action.TIMER_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timer_info" />
        </receiver>
        <receiver
            android:name=".widgets.ComplianceWidgetProvider"
            android:exported="false"
            android:label="@string/widget_compliance_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compliance_info" />
        </receiver>
        <receiver
            android:name=".widgets.NutritionWidgetProvider"
            android:exported="false"
            android:label="@string/widget_nutrition_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.healthengine.app.action.WIDGET_WATER" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_nutrition_info" />
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Камера: только для pickPhoto() (фото тела/чеков/анализов).
         required=false — фильтр Play по наличию камеры не включается.
         Галерея идёт через системный picker и отдельных разрешений не требует. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Уведомления/точные тики: задекларированы плагином local-notifications
         (POST_NOTIFICATIONS/SCHEDULE_EXACT_ALARM/RECEIVE_BOOT_COMPLETED),
         здесь не дублируются — merge из библиотеки. -->
    <!-- Точные тики таймера отдыха (на Android 12+ без гранта тикают неточно — таймер самокорректируется по endAt) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Биометрия через WebAuthn platform authenticator (см. native-bridge authenticateWithBiometrics) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
