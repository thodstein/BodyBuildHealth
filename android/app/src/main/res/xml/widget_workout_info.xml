<?xml version="1.0" encoding="utf-8"?>
<!-- Высота = 5 строк подходов по 48dp + шапка/прогресс + ряд кнопок ≈ 400dp.
     При 240dp/4 ячейках нижний ряд («Начать»/«Открыть») обрезался лаунчером. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_workout_desc"
    android:initialLayout="@layout/widget_workout"
    android:minHeight="400dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_workout"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="5"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
