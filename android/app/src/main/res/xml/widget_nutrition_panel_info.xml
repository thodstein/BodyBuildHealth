<?xml version="1.0" encoding="utf-8"?>
<!-- Двойной виджет аналитики питания: две половины со своей метрикой и периодом. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:minResizeWidth="160dp"
    android:minResizeHeight="150dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_nutrition_panel"
    android:description="@string/widget_nutrition_panel_desc"
    android:previewLayout="@layout/widget_nutrition_panel"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
