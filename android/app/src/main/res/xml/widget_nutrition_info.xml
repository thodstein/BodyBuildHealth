<?xml version="1.0" encoding="utf-8"?>
<!-- Питание 3×4: аналитика КБЖУ за день / неделю / месяц + быстрые действия. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="250dp"
    android:minResizeWidth="160dp"
    android:minResizeHeight="220dp"
    android:targetCellWidth="3"
    android:targetCellHeight="4"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_nutrition"
    android:description="@string/widget_nutrition_desc"
    android:previewLayout="@layout/widget_nutrition"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
