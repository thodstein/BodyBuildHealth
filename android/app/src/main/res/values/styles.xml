<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- PRO: системные бары в фирменный navy (мост initNativeChrome дублирует в рантайме) -->
        <item name="android:statusBarColor">@color/pro_navy_deep</item>
        <item name="android:navigationBarColor">@color/pro_navy_deep</item>
        <!-- TOP: светлые иконки баров поверх тёмного navy; жестовый хинт не залипает -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- TOP: SplashScreen API 31+ — фон и иконка 1-в-1 с Web-слоем.
             На старых API игнорируется, работает прежний @drawable/splash. -->
        <item name="windowSplashScreenBackground">@color/pro_navy_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <!-- TOP: подложка под иконку сплэша — без неё глиф висит на голом фоне -->
        <item name="windowSplashScreenIconBackgroundColor">@color/pro_navy</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>