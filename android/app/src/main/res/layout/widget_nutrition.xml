<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_nut_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp"
    android:contentDescription="@string/widget_nutrition_desc">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HE · ПИТАНИЕ"
        android:textColor="#C9F73A"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_nut_kcal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Дневник питания"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_nut_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Ккал, белок и вода за сегодня"
        android:textColor="#8FA3C4"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/w_nut_queue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" "
        android:textColor="#C9F73A"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_nut_water"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:padding="10dp"
            android:text="+250 мл"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_nut_water500"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:padding="10dp"
            android:text="+500 мл"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_nut_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_action"
            android:gravity="center"
            android:padding="10dp"
            android:text="+ Еда"
            android:textColor="#C9F73A"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
