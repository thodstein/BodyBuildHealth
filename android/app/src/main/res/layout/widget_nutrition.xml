<?xml version="1.0" encoding="utf-8"?>
<!--
    Виджет «Питание» 3×5 — аналитика КБЖУ за день / неделю / месяц.
    Чипы «Д · Н · М» переключают период per-widget, «‹ ›» листают даты недели:
    агрегаты и дни приходят готовыми в снапшоте (periods/days), поэтому виджет
    считается без открытия приложения. Ниже — сводка с остатком Б/Ж/У, вода и
    список позиций дня (RemoteViewsService) с удалением, чипы недавних блюд и
    быстрые действия: своя еда (нативный редактор), скан, фото этикетки.
    Высоты подобраны так, чтобы всё помещалось в 5 строк (~320dp).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_nut_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:contentDescription="@string/widget_nutrition_desc">

    <!-- Шапка: название + дата/период + очередь быстрых записей -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="HE · ПИТАНИЕ"
            android:textColor="#C9F73A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_nut_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="#8FA3C4"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/w_nut_queue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text=""
            android:textColor="#C9F73A"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Период аналитики: день / неделя / месяц (per-widget) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_nut_prev"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="‹"
            android:textColor="#E2ECFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_nut_p_day"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_on"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="День"
            android:textColor="#07111F"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_nut_p_week"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Неделя"
            android:textColor="#E2ECFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_nut_p_month"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Месяц"
            android:textColor="#E2ECFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_nut_next"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="›"
            android:textColor="#E2ECFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Калории крупно: круг процента + факт и цель -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp">

            <ProgressBar
                android:id="@+id/w_nut_kcal_ring"
                style="@style/WidgetRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_ring_kcal" />

            <TextView
                android:id="@+id/w_nut_kcal_pct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="0%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:text="ККАЛ"
                android:textColor="#8FA3C4"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_nut_kcal_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_nut_kcal_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="цель не задана"
                android:textColor="#8FA3C4"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Белки / жиры / углеводы: круги процента и «факт / цель» -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp">

                <ProgressBar
                    android:id="@+id/w_nut_p_ring"
                    style="@style/WidgetRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_ring_protein" />

                <TextView
                    android:id="@+id/w_nut_p_pct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="Белки"
                android:textColor="#60A5FA"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_nut_p_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0/0"
                android:textColor="#E2ECFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp">

                <ProgressBar
                    android:id="@+id/w_nut_f_ring"
                    style="@style/WidgetRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_ring_fat" />

                <TextView
                    android:id="@+id/w_nut_f_pct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="Жиры"
                android:textColor="#F59E0B"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_nut_f_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0/0"
                android:textColor="#E2ECFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp">

                <ProgressBar
                    android:id="@+id/w_nut_c_ring"
                    style="@style/WidgetRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_ring_carbs" />

                <TextView
                    android:id="@+id/w_nut_c_pct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="Углев."
                android:textColor="#F97316"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_nut_c_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0/0"
                android:textColor="#E2ECFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Сводка периода: остаток дня или сумма и число дней с записями -->
    <TextView
        android:id="@+id/w_nut_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Данных за сегодня пока нет"
        android:textColor="#8FA3C4"
        android:textSize="9sp" />

    <!-- Вода -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_nut_water_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Вода 0 / 0 мл"
            android:textColor="#38BDF8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_nut_water_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0%"
            android:textColor="#8FA3C4"
            android:textSize="9sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_nut_water_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="2dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_bar_water" />

    <!-- Список позиций дня: строки приходят из RemoteViewsService, «✕» удаляет -->
    <FrameLayout
        android:id="@+id/w_nut_items_box"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="3dp">

        <ListView
            android:id="@+id/w_nut_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/w_nut_items_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="Пока пусто — добавьте еду"
            android:textColor="#8FA3C4"
            android:textSize="9sp" />
    </FrameLayout>

    <!-- Чипы «недавние / избранное»: тап = запись в день без ввода КБЖУ -->
    <LinearLayout
        android:id="@+id/w_nut_quick_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_nut_q1"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#E2ECFF"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/w_nut_q2"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#E2ECFF"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/w_nut_q3"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#E2ECFF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Быстрые действия: еда / скан / фото (для прошлых дней скрыты) -->
    <LinearLayout
        android:id="@+id/w_nut_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_nut_food"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.3"
            android:background="@drawable/widget_chip_on"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="＋ Еда"
            android:textColor="#07111F"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- «↩» — отмена последней записи еды; показывается только когда есть что отменять. -->
        <TextView
            android:id="@+id/w_nut_food_undo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="↩"
            android:textColor="#E2ECFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_nut_scan"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Скан"
            android:textColor="#E2ECFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_nut_photo"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Фото"
            android:textColor="#E2ECFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Вода в один тап + свой объём (для прошлых дней скрыты) -->
    <LinearLayout
        android:id="@+id/w_nut_water_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <!-- «−250» — коррекция воды, если порцию нажали по ошибке. -->
        <TextView
            android:id="@+id/w_nut_water_minus"
            android:layout_width="34dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="−250"
            android:textColor="#E2ECFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_nut_water"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+250 мл"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_nut_water500"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+500 мл"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_nut_open"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:background="@drawable/widget_action"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Свой"
            android:textColor="#C9F73A"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
