<?xml version="1.0" encoding="utf-8"?>
<!--
    Виджет «Календарь» — агенда дня в духе TickTick:
    дата, счётчик сделанных задач, до трёх задач с отметкой и «＋ Задача».
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_cal_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="HE · КАЛЕНДАРЬ"
            android:textColor="#C9F73A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_cal_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="#8FA3C4"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/w_cal_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="#8FA3C4"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/w_cal_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="26dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_cal_check1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="○"
                android:textColor="#8FA3C4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_cal_title1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_cal_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="26dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_cal_check2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="○"
                android:textColor="#8FA3C4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_cal_title2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_cal_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="26dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_cal_check3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="○"
                android:textColor="#8FA3C4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_cal_title3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_cal_overdue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text=""
            android:textColor="#F59E0B"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_cal_open"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_action"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="＋ Задача"
            android:textColor="#C9F73A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
