<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Проведение тренировки»: упражнения назначенной сессии + ввод подхода. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_wo_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:contentDescription="@string/widget_workout_desc"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="HE · ПРОВЕДЕНИЕ"
            android:textColor="#C9F73A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_wo_stamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#8FA3C4"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_wo_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Тренировка"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_wo_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="План дня"
        android:textColor="#E2ECFF"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/w_wo_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#24405F"
        android:progressTint="#C9F73A" />

    <!-- Строка упражнения: номер, название + план, прогресс подходов, «＋». -->
    <LinearLayout
        android:id="@+id/w_wo_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_wo_idx1"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="1"
            android:textColor="#8FA3C4"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_wo_name1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Упражнение"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_wo_plan1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=" " 
                android:textColor="#8FA3C4"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_wo_done1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:includeFontPadding="false"
            android:text="0/0"
            android:textColor="#C9F73A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_wo_add1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="Записать подход"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="＋"
            android:textColor="#C9F73A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_wo_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_wo_idx2"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="2"
            android:textColor="#8FA3C4"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_wo_name2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Упражнение"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_wo_plan2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=" "
                android:textColor="#8FA3C4"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_wo_done2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:includeFontPadding="false"
            android:text="0/0"
            android:textColor="#C9F73A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_wo_add2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="Записать подход"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="＋"
            android:textColor="#C9F73A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_wo_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_wo_idx3"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="3"
            android:textColor="#8FA3C4"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_wo_name3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Упражнение"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_wo_plan3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=" "
                android:textColor="#8FA3C4"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_wo_done3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:includeFontPadding="false"
            android:text="0/0"
            android:textColor="#C9F73A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_wo_add3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="Записать подход"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="＋"
            android:textColor="#C9F73A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_wo_row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_wo_idx4"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="4"
            android:textColor="#8FA3C4"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_wo_name4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Упражнение"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_wo_plan4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=" "
                android:textColor="#8FA3C4"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_wo_done4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:includeFontPadding="false"
            android:text="0/0"
            android:textColor="#C9F73A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_wo_add4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="Записать подход"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="＋"
            android:textColor="#C9F73A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_wo_row5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_wo_idx5"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="5"
            android:textColor="#8FA3C4"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_wo_name5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Упражнение"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_wo_plan5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=" "
                android:textColor="#8FA3C4"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_wo_done5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:includeFontPadding="false"
            android:text="0/0"
            android:textColor="#C9F73A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_wo_add5"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="Записать подход"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="＋"
            android:textColor="#C9F73A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_wo_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="План не найден — откройте Тренировку"
        android:textColor="#8FA3C4"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_wo_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_action"
            android:contentDescription="Начать тренировку"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="9dp"
            android:text="▶ Начать"
            android:textColor="#C9F73A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_wo_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_action"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingLeft="14dp"
            android:paddingTop="9dp"
            android:paddingRight="14dp"
            android:paddingBottom="9dp"
            android:text="Открыть"
            android:textColor="#E2ECFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
