<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_comp_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp"
    android:contentDescription="@string/widget_compliance_desc">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HE · КОМПЛАЕНС"
        android:textColor="#C9F73A"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_comp_pct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="—"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_comp_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Комплаенс"
        android:textColor="#E2ECFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_comp_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Откройте приложение"
        android:textColor="#8FA3C4"
        android:textSize="11sp" />

    <ProgressBar
        android:id="@+id/w_comp_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0" />
</LinearLayout>
