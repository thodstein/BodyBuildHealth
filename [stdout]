30\u0441\u0442\u0440\u0430\u0433\u0430\u043B); \u043C\u0435\u0442\u0438\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 (\u0422\u041C\u0413, 5-MTHF, \u043B\u0435\u0446\u0438\u0442\u0438\u043D); \u043A\u0430\u0440\u0434\u0438\u043E-\u043C\u0435\u0442\u0430\u0431\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430 (\u0442\u0435\u043B\u043C\u0438\u0441\u0430\u0440\u0442\u0430\u043D, \u0431\u0435\u0440\u0433\u0430\u043C\u043E\u0442, \u0430\u0433\u043C\u0430\u0442\u0438\u043D, \u0442\u0430\u0443\u0440\u0438\u043D); \u0433\u0435\u043F\u0430\u0442\u043E\u043F\u0440\u043E\u0442\u0435\u043A\u0446\u0438\u044F (\u0423\u0414\u0425\u041A, NAC, \u043B\u0435\u0433\u0430\u043B\u043E\u043D, \u0431\u0435\u0440\u0431\u0435\u0440\u0438\u043D); \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u0430\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430 (\u041C\u0421\u041C, \u0431\u043E\u0441\u0432\u0435\u043B\u043B\u0438\u044F); \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u043C\u0438\u0442\u043E\u0445\u043E\u043D\u0434\u0440\u0438\u0439 (\u0438\u043D\u043E\u0437\u0438\u043D, CoQ10, \u0442\u0438\u0430\u043C\u0438\u043D); \u0441\u0442\u0440\u0435\u0441\u0441-\u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043D\u0442\u043D\u043E\u0441\u0442\u044C (\u0442\u0435\u0430\u043D\u0438\u043D, \u0430\u0448\u0432\u0430\u0433\u0430\u043D\u0434\u0430, \u0433\u043B\u0438\u0446\u0438\u043D, \u043C\u0430\u0433\u043D\u0438\u0439 L-\u0442\u0440\u0435\u043E\u043D\u0430\u0442).",
    synergyPrinciple: "\u0421\u0438\u043D\u0435\u0440\u0433\u0438\u044F \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437 \u043E\u0445\u0432\u0430\u0442 7 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445 \u043F\u0443\u0442\u0435\u0439: 1) \u0430\u0446\u0435\u0442\u0438\u043B\u0445\u043E\u043B\u0438\u043D (Alpha-GPC+CDP-\u0445\u043E\u043B\u0438\u043D+\u0433\u0443\u043F\u0435\u0440\u0437\u0438\u043D) \u0434\u043B\u044F \u043D\u0435\u0439\u0440\u043E\u043F\u043B\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438; 2) \u0444\u0438\u0431\u0440\u0438\u043D\u043E\u043B\u0438\u0437 (\u0441\u0435\u0440\u0440\u0430+\u043D\u0430\u0442\u0442\u043E+\u0431\u0440\u043E\u043C\u0435\u043B\u0430\u0439\u043D) \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438 \u0440\u0430\u0437\u043D\u044B\u0445 \u043F\u0440\u043E\u0442\u0435\u0430\u0437\u044B; 3) \u0433\u0440\u0438\u0431\u043D\u044B\u0435 \u03B2-\u0433\u043B\u044E\u043A\u0430\u043D\u044B (\u043A\u043E\u0440\u0434\u0438\u0446\u0435\u043F\u0441+\u0440\u0435\u0439\u0448\u0438+\u0435\u0436\u043E\u0432\u0438\u043A) \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044E\u0442 \u0438\u043C\u043C\u0443\u043D\u0438\u0442\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u043A\u0442\u0438\u043D-1; 4) \u0444\u043B\u0430\u0432\u043E\u043D\u043E\u0438\u0434\u044B (\u0434\u0438\u043E\u0441\u043C\u0438\u043D+\u0440\u0443\u0442\u0438\u043D+\u0433\u0435\u0441\u043F\u0435\u0440\u0438\u0434\u0438\u043D+\u043F\u0438\u043A\u043D\u043E\u0433\u0435\u043D\u043E\u043B) \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0442 \u0441\u043E\u0441\u0443\u0434\u0438\u0441\u0442\u044B\u0439 \u044D\u043D\u0434\u043E\u0442\u0435\u043B\u0438\u0439 \u0441\u0438\u043D\u0435\u0440\u0433\u0438\u0447\u043D\u043E; 5) \u043C\u0435\u0442\u0438\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 (\u0422\u041C\u0413+5-MTHF+\u043B\u0435\u0446\u0438\u0442\u0438\u043D) + \u0433\u0435\u043F\u0430\u0442\u043E\u043F\u0440\u043E\u0442\