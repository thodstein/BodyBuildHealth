    specialInstructions: "\u0413\u0435\u043F\u0442\u0440\u0430\u043B: 15 \u0438\u043D\u044A\u0435\u043A\u0446\u0438\u0439 \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u043E, \u0422\u041E\u041B\u042C\u041A\u041E \u0432\u043D\u0443\u0442\u0440\u0438\u043C\u044B\u0448\u0435\u0447\u043D\u043E (\u0432/\u0432 \u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F), \u0432\u0432\u043E\u0434\u0438\u0442\u044C \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u041F\u043E\u0441\u043B\u0435 15 \u0443\u043A\u043E\u043B\u043E\u0432 \u2014 \u043E\u0442\u043C\u0435\u043D\u0430 (\u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0442\u0438\u0442\u0440\u0430\u0446\u0438\u0438 \u0432\u043D\u0438\u0437). NAC \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u043D\u0430\u0442\u043E\u0449\u0430\u043A \u0437\u0430 30-60 \u043C\u0438\u043D \u0434\u043E \u0435\u0434\u044B. \u0418\u043D\u0442\u0435\u0440\u0432\u0430\u043B NAC \u0438 \u0430\u043D\u0442\u0438\u0431\u0438\u043E\u0442\u0438\u043A\u0438 \u22652 \u0447. TUDCA \u0441\u0442\u0430\u0440\u0442 500 \u043C\u0433 \xD7 3 \u0434\u043D\u044F \u2192 \u0442\u0438\u0442\u0440\u0430\u0446\u0438\u044F \u0434\u043E 1500 \u043C\u0433. \u041B\u0435\u0446\u0438\u0442\u0438\u043D \u0438 \u041B\u0435\u0433\u0430\u043B\u043E\u043D \u0421 \u0415\u0414\u041E\u0419.",
    contraindications: "\u0416\u041A\u0411 \u0441 \u043A\u0430\u043C\u043D\u044F\u043C\u0438 >5 \u043C\u043C (TUDCA \u043C\u043E\u0436\u0435\u0442 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u0442\u044C \u2192 \u0437\u0430\u043A\u0443\u043F\u043E\u0440\u043A\u0430). \u0411\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u044C (\u0413\u0435\u043F\u0442\u0440\u0430\u043B, \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u044F B \u2014 \u0441 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E). \u0422\u044F\u0436\u0451\u043B\u0430\u044F \u043F\u043E\u0447\u0435\u0447\u043D\u0430\u044F \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C (\u0442\u0430\u0443\u0440\u0438\u043D \u0432\u044B\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u043F\u043E\u0447\u043A\u0430\u043C\u0438). \u041E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u0438\u0451\u043C L-\u0434\u043E\u043F\u044B (\u0413\u0435\u043F\u0442\u0440\u0430\u043B \u2193 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C).",
    warnings: "\u26A0 \u0413\u0435\u043F\u0442\u0440\u0430\u043B: \u0431\u043E\u043B\u044C \u0432 \u043C\u0435\u0441\u0442\u0435 \u0438\u043D\u044A\u0435\u043A\u0446\u0438\u0438 (\u043E\u0445\u043B\u0430\u0436\u0434\u0430\u0442\u044C \u0430\u043C\u043F\u0443\u043B\u0443), \u0442\u043E\u0448\u043D\u043E\u0442\u0430 \u043F\u0435\u0440\u0432\u044B\u0435 3-5 \u0434\u043D\u0435\u0439. \u26A0 TUDCA: \u043F\u043E\u0441\u043B\u0430\u0431\u043B\u0435\u043D\u0438\u0435 \u0441\u0442\u0443\u043B\u0430 \u043F\u0435\u0440\u0432\u044B\u0435 2 \u043D\u0435\u0434 \u2014 \u0441\u0442\u0430\u0440\u0442 500 \u043C\u0433 \u0438 \u0442\u0438\u0442\u0440\u0430\u0446\u0438\u044F. \u26A0 NAC >3000 \u043C\u0433/\u0441\u0443\u0442: \u0442\u043E\u0448\u043D\u043E\u0442\u0430, \u0433\u043E\u043B\u043E\u0432\u043D\u0430\u044F \u0431\u043E\u043B\u044C. \u26A0 \u041B\u0435\u0446\u0438\u0442\u0438\u043D: \u0434\u0438\u0430\u0440\u0435\u044F \u043F\u0440\u0438 >5 \u0433/\u0441\u0443\u0442. \u26A0 \u041F\u0440\u0438 \u0410\u041B\u0422 >500 \u0415\u0434/\u043B \u2014 \u041D\u0415\u041C\u0415\u0414\u041B\u0415\u041D\u041D\u041E \u043A \u0432\u0440\u0430\u0447\u0443, \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C \u043E\u0440\u0430\u043B\u044C\u043D\u044B\u0435 \u0410\u0410\u0421.",
