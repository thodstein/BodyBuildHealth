  { a: "magnesium_l_threonate", b: "theanine", type: "synergy", effect: "\u0422\u043E\u0440\u043C\u043E\u0437\u043D\u043E\u0439 \u043A\u0432\u0430\u0440\u0442\u0435\u0442: \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u043D\u0435\u0439\u0440\u043E\u043F\u0440\u043E\u0442\u0435\u043A\u0446\u0438\u044F", mechanism: "\u041C\u0430\u0433\u043D\u0438\u0439 L-\u0442\u0440\u0435\u043E\u043D\u0430\u0442 \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F \u0444\u043E\u0440\u043C\u0430 Mg, \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E \u2191 Mg \u0432 \u043C\u043E\u0437\u0433\u0435 \u0447\u0435\u0440\u0435\u0437 \u0413\u042D\u0411, \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442 NMDA, \u2191 \u0441\u0438\u043D\u0430\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u043F\u043B\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u044C. L-\u0442\u0435\u0430\u043D\u0438\u043D \u2014 \u2191 \u0430\u043B\u044C\u0444\u0430-\u0432\u043E\u043B\u043D\u044B, \u2193 \u0433\u043B\u0443\u0442\u0430\u043C\u0430\u0442, \u2191 \u0413\u0410\u041C\u041A \u0447\u0435\u0440\u0435\u0437 \u0438\u043D\u0433\u0438\u0431\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u0433\u043B\u0443\u0442\u0430\u043C\u0438\u043D\u0430\u0437\u044B. \u0413\u043B\u0438\u0446\u0438\u043D \u2014 \u043A\u043E-\u0430\u0433\u043E\u043D\u0438\u0441\u0442 NMDA (\u043D\u043E \u0432 \u0441\u043F\u0438\u043D\u043D\u043E\u043C \u043C\u043E\u0437\u0433\u0435 \u2014 \u0442\u043E\u0440\u043C\u043E\u0437\u043D\u044B\u0439 GlyR), \u2191 \u0434\u0435\u043B\u044C\u0442\u0430-\u0441\u043E\u043D. \u0422\u0430\u0443\u0440\u0438\u043D \u2014 \u0430\u0433\u043E\u043D\u0438\u0441\u0442 \u0413\u0410\u041C\u041A-\u0410, \u043E\u0441\u043C\u043E\u0440\u0435\u0433\u0443\u043B\u044F\u0442\u043E\u0440, \u2191 Cl-\u0442\u043E\u043A, \u2193 \u0432\u043D\u0443\u0442\u0440\u0438\u043A\u043B\u0435\u0442\u043E\u0447\u043D\u044B\u0439 Ca2+. \u0421\u0438\u043D\u0435\u04