  { a: "lions_mane", b: "noopept", type: "synergy", effect: "\u041D\u0435\u0439\u0440\u043E\u0433\u0435\u043D\u0435\u0437 + \u0444\u0430\u043A\u0442\u043E\u0440\u044B \u0440\u043E\u0441\u0442\u0430 + \u0445\u043E\u043B\u0438\u043D", mechanism: "Lion's Mane \u2192 \u2191 NGF \u0447\u0435\u0440\u0435\u0437 ERK1/2 \u0432 \u0430\u0441\u0442\u0440\u043E\u0446\u0438\u0442\u0430\u0445, \u2191 \u043C\u0438\u0435\u043B\u0438\u043D\u0438\u0437\u0430\u0446\u0438\u044E. \u041D\u043E\u043E\u043F\u0435\u043F\u0442 \u2192 \u2191 BDNF, \u2191 NGF, \u043C\u043E\u0434\u0443\u043B\u044F\u0446\u0438\u044F AMPA. Alpha-GPC \u2192 \u2191 \u0445\u043E\u043B\u0438\u043D \u0432 \u043C\u043E\u0437\u0433\u0435, \u2191 \u0444\u043E\u0441\u0444\u043E\u0442\u0438\u0434\u0438\u043B\u0445\u043E\u043B\u0438\u043D \u0434\u043B\u044F \u043C\u0435\u043C\u0431\u0440\u0430\u043D, \u2191 GH. \u0421\u0438\u043D\u0435\u0440\u0433\u0438\u044F: NGF (\u0435\u0436\u043E\u0432\u0438\u043A) + BDNF (\u043D\u043E\u043E\u043F\u0435\u043F\u0442) + \u043C\u0435\u043C\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u0441\u0443\u0431\u0441\u0442\u0440\u0430\u0442 (alpha-GPC) = \u043F\u043E\u043B\u043D\u044B\u0439 \u0446\u0438\u043A\u043B \u043D\u0435\u0439\u0440\u043E\u0433\u0435\u043D\u0435\u0437\u0430: \u0440\u043E\u0441\u0442, \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0440\u043E\u0432\u043A\u0430 \u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430 \u043D\u043E\u0432\u044B\u0445 \u043D\u0435\u0439\u0440\u043E\u043D\u043E\u0432", severity: "HIGH", score: 9 },
