{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "permissions": [
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "dist/*", "effect": "deny" },
    { "action": "edit", "resource": "dist-native/*", "effect": "deny" },
    { "action": "edit", "resource": "android/app/build/*", "effect": "deny" },
    { "action": "edit", "resource": "android/build/*", "effect": "deny" },
    { "action": "edit", "resource": "android/.gradle/*", "effect": "deny" },
    { "action": "edit", "resource": "node_modules/*", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean -fd *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": ["C:\\Users\\thods\\.local\\bin\\browse.exe", "mcp"],
        "cwd": "C:\\Users\\thods",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      },
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?read_only=true&features=database,debugging,docs"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "pubmed": {
        "type": "remote",
        "url": "https://pubmed.caseyjhand.com/mcp"
      },
      "openalex": {
        "type": "remote",
        "url": "https://openalex.caseyjhand.com/mcp"
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/"
      }
    }
  }
}
